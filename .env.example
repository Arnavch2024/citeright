# Copy to .env. Never commit secrets.

# openai | gemini | fake
# gemini = Google AI Studio free tier (https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_CHEAP_MODEL=gemini-2.5-flash
GEMINI_STRONG_MODEL=gemini-2.5-pro

# Search / fetch
EXA_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# Hard caps
MAX_TOOL_CALLS=20
MAX_REPLANS=1
MAX_TOKENS_PER_CALL=4096
PER_CALL_TIMEOUT_S=45
TOTAL_WALL_CLOCK_S=180
TOOL_TIMEOUT_S=20

# Cache (keyed by query/URL; keep on for reproducible evals)
CACHE_ENABLED=true
CACHE_DIR=.cache

# Retrieval: bm25 | embeddings
RETRIEVAL_BACKEND=bm25
PASSAGES_K=5

TRACES_DIR=traces
OUTPUTS_DIR=outputs
